# 1. Get a free key at https://aistudio.google.com/apikey
# 2. Copy this file to .env and paste your key below. Never commit .env.
GEMINI_API_KEY=
# Optional: change the model if Google renames it (see https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
